<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="dep7_audit_wizard_form_view">
        <field name="model">dep7.data.export.audit.wizard</field>
        <field name="name">dep7.data.export.audit.wizard</field>
        <field name="arch" type="xml">
            <form string="DEP7 Data Export Audit Wizard">
                <group>
                    <field name="l10n_at_start_receipt_number"/>
                    <field name="l10n_at_end_receipt_number"/>
                    <field name="l10n_at_start_time_signature"/>
                    <field name="l10n_at_end_time_signature"/>
                </group>
                <footer>
                    <button name="action_export_audit" string="Export Data" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dep7_data_export_audit_wizard" model="ir.actions.act_window">
        <field name="name">DEP7 Data Export Audit Wizard</field>
        <field name="res_model">dep7.data.export.audit.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="dep7_audit_wizard_form_view"/>
        <field name="target">new</field>
    </record>
</odoo>