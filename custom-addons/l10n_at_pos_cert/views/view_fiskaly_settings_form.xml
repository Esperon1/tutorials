<odoo>
    <record id="view_pos_config_form_fiskaly" model="ir.ui.view">
        <field name="name">pos.config.settings.fiskaly</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='row mt16 o_settings_container']" position="inside">
                <div class="o_setting_box col-12 col-lg-6">
                    <div class="o_setting_left_pane">
                        <label class="o_form_label" for="fiskaly_api_key">Fiskaly API Key</label>
                        <label class="o_form_label" for="fiskaly_api_secret">Fiskaly API Secret</label>
                        <label class="o_form_label" for="fiskaly_scu_id">Fiskaly SCU ID</label>
                        <label class="o_form_label" for="fiskaly_cash_register_id">Fiskaly Cash Register ID</label>
                    </div>
                    <div class="o_setting_right_pane">
                        <field name="fiskaly_api_key"/>
                        <field name="fiskaly_api_secret"/>
                        <field name="fiskaly_scu_id" readonly="1"/>
                        <field name="fiskaly_cash_register_id" readonly="1"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
