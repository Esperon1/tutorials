<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_pos_config_kanban_inherited" model="ir.ui.view">
            <field name="name">view.pos.config.kanban.inherited</field>
            <field name="model">pos.config</field>
            <field name="inherit_id" ref="point_of_sale.view_pos_config_kanban"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@class='container dropdown-pos-config']//div[@class='col-6']" position="inside">
                    <field name="is_company_country_austria" invisible="1"/>
                    <div role="menuitem" invisible='not is_company_country_austria'>
                        <a name="%(action_dep7_data_export_audit_wizard)d" type="action" class="o_kanban_button">
                            DEP7 Receipts Data Export
                        </a>

                        <a name="action_transition_to_defective_cash_register" type="object" class="o_kanban_button" confirm="You sure you want report Cash Register non-repairable defect? Once it is in DEFECTIVE state, you cannot use it again.">
                            Report Defective Cash Register
                        </a>

                    </div>
                </xpath>
                <xpath expr="//div[@class='row g-0 pb-4 ms-2 mt-auto']" position="inside">
                    <div class="d-flex flex-row justify-content-end">
                        <button class="btn btn-secondary mx-1" type="object" invisible="current_session_state == 'opened'"
                                name="action_transition_cash_register_to_outage" confirm="You sure you want to report OUTAGE?">Outage Cash Register</button>
                        <button class="btn btn-secondary" type="object" invisible="current_session_state == 'opened'"
                                name="action_transition_back_to_initialised" confirm="You sure you want to initialize the Cash Register?">Initialize Cash Register</button>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
