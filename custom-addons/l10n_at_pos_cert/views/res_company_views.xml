<odoo>
    <data>

        <record id="view_company_form_inherit" model="ir.ui.view">
            <field name="name">res.company.form.inherit</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='currency_id']" position="after">
                    <field name="l10n_at_fon_participant" invisible="country_code != 'AT'"/>
                    <field name="l10n_at_fon_user_id" invisible="country_code != 'AT'"/>
                    <field name="l10n_at_fon_pin" invisible="country_code != 'AT'"/>
                    <field name="l10n_at_legal_entity_type" invisible="country_code != 'AT'"/>
                    <field name="l10n_at_legal_entity" invisible="country_code != 'AT'"/>
                    <field name="l10n_at_scu_id" invisible="country_code != 'AT'"/>
                    <button name="action_generate_scu"
                            type="object"
                            string="Generate SCU"
                            class="oe_highlight"

                            invisible="country_code != 'AT' or l10n_at_scu_id"/>
                    <button name="action_decommission_scu"
                            type="object"
                            string="Decommission SCU"
                            class="oe_highlight"
                            invisible="country_code != 'AT' or country_code == 'AT' and not l10n_at_scu_id"
                            confirm="Are you sure you want to Decommission SCU? If decommissioned, you will NOT be able to use the previous SCU ID."/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
