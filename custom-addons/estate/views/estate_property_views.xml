<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_available': True}</field> <!-- Default filter -->
    </record>

    <record id="estate_property_list_view" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Properties" decoration-success="state=='offer_received'"
                  decoration-primary="state=='offer_accepted'"
                  decoration-muted="state=='sold'" decoration-bf="state=='offer_accepted'"
                  decoration-danger="state=='canceled'">
                <field name="name" string="Title" width="50"/>
                <field name="property_type_id" width="50" widget="many2one" optional="hide"/>
                <field name="postcode" string="Postcode" width="50"/>
                <field name="tags_ids" string="Tags" width="50" widget="many2many_tags" optional="hide"/>
                <field name="bedrooms" string="Bedrooms" width="50"/>
                <field name="living_area" string="Living Area (sqm)" width="100"/>
                <field name="expected_price" string="Expected Price" width="50"/>
                <field name="selling_price" string="Selling Price" width="150"/>
                <field name="availability_date" string="Available From" width="100" options="{'datepicker': True}"
                       optional="hide"/>
                <field name="state" string="Offer Status" width="150" optional="hide"/>

            </list>
        </field>
    </record>


    <record id="estate_property_form_view" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header>
                    <button name="action_sold" type="object" string="Sold" invisible="state=='sold'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state=='sold'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,offer_received,offer_accepted,sold,canceled"/>
                </header>
                <sheet>
                    <group>
                        <div class="o_form_field o_form_header_name">
                            <h1>
                                <field name="name"/>
                            </h1>
                            <field name="tags_ids" widget="many2many_tags" options="{'color_field':'color'}"/>
                        </div>
                    </group>
                    <group>
                        <group>
                            <field name="property_type_id" style="color: darkcyan;"
                                   options="{'no_create': True, 'no_create_edit': True, 'domain': [('id','>', 0)]}"/>
                            <field name="postcode"/>
                            <field name="availability_date"/>
                            <field name="partner_id" style="color: darkcyan;" readonly="1"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="best_offer"/>
                            <field name="selling_price"/>
                            <field name="state" string="Offer Status"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Details">
                            <group>
                                <field name="description"/>
                                <field name="bedrooms"/>
                                <field name="living_area" string="Living Area (sqm)"/>
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area" string="Garden Area (sqm)" invisible="not garden"/>
                                <field name="garden_orientation" invisible="not garden"/>
                                <field name="total_area"/>

                            </group>
                        </page>
                        <page string="Other Info">
                            <group>
                                <field name="salesperson_id" style="color: darkcyan;"/>
                                <field name="buyer_id" style="color: darkcyan;"/>
                            </group>
                        </page>

                        <page string="Offers">
                            <field name="offer_ids" widget="one2many"
                                   readonly="state in ['offer_accepted', 'sold', 'canceled']"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_search_view" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Search Estates">
                <field name="name"/>
                <field name="living_area" string="Living Area Greater Than" filter_domain="[('living_area', '>=', self)]"/>
                <filter name="available" string="Available"
                        domain="[('name', 'ilike', 'Available')]"
                        help="Show available records."/> <!--ilike filter allows case-sensitive search-->
            </search>
        </field>
    </record>
</odoo>
